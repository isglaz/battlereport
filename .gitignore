# General ignores
.DS_Store
build
out
kotlin-js-store

# IntelliJ ignores
# Simpler to ignore the whole folder: it holds nothing the repository needs, and the
# individual files (workspace.xml and the like) are regenerated by the IDE itself.
.idea/
*.iml
/*.ipr

# Gradle ignores
.gradle

# Kotlin ignores
.kotlin

# Local databases (H2 creates them when the server starts)
*.mv.db
*.trace.db

# Generated OpenAPI documentation (swagger-codegen from documentation.yaml)
/docs/
/server/docs/

# Local environment variables
.env
.env.local
