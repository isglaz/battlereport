# Скопируйте в .env и при необходимости поправьте: docker compose читает .env
# из каталога с compose-файлом автоматически. Сам .env в репозиторий не коммитится.
#
# На проде такой же файл лежит на сервере рядом с compose-файлами, вне репозитория,
# и заполняется из параметров TeamCity.

# --- Postgres ---
POSTGRES_DB=battlereport
POSTGRES_USER=battlereport
POSTGRES_PASSWORD=battlereport
POSTGRES_PORT=5432

# --- Сервер ---
# Приложение ходит в БД через R2DBC, Liquibase — через JDBC: отсюда два URL на одну БД.
# Хост `postgres` — имя сервиса в compose-сети.
DB_URL=r2dbc:postgresql://postgres:5432/battlereport
DB_JDBC_URL=jdbc:postgresql://postgres:5432/battlereport
DB_USER=battlereport
DB_PASSWORD=battlereport
SERVER_PORT=8080

# --- Фронт ---
SITE_PORT=8081

# --- Прод (используются только в compose.prod.yaml) ---
# REGISTRY=ghcr.io/isglaz
# TAG=latest
