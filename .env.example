# Copy to .env and adjust if needed: docker compose reads .env from the directory
# holding the compose file automatically. The .env itself is not committed.
#
# In production the same file sits on the server next to the compose files, outside the
# repository, and is filled in from TeamCity parameters.

# --- Postgres ---
POSTGRES_DB=battlereport
POSTGRES_USER=battlereport
POSTGRES_PASSWORD=battlereport
POSTGRES_PORT=5432

# --- Server ---
# The application talks to the database over R2DBC, Liquibase over JDBC: hence two URLs for one database.
# The `postgres` host is the service name inside the compose network.
DB_URL=r2dbc:postgresql://postgres:5432/battlereport
DB_JDBC_URL=jdbc:postgresql://postgres:5432/battlereport
DB_USER=battlereport
DB_PASSWORD=battlereport
SERVER_PORT=8080

# --- Frontend ---
SITE_PORT=8081

# --- Production (used only by compose.prod.yaml) ---
# REGISTRY=ghcr.io/isglaz
# TAG=latest
