# Uniform line endings on every platform, regardless of core.autocrlf on the developer's
# machine: git detects text files itself and checks them out with LF.
#
# This is not cosmetic: scripts from the repository run inside Linux containers, and a
# shebang with \r is not executable there - gradlew and deploy/*.sh fail with exit 127.
* text=auto eol=lf

# Batch files are read by cmd.exe, which breaks on LF inside multi-line constructs.
*.bat text eol=crlf
*.cmd text eol=crlf

# git usually detects binaries on its own, but the wrapper jar lives in the repository -
# corrupting it through line-ending conversion would be painful.
*.jar binary
*.ico binary
*.mv.db binary
